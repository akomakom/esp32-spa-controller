#ifndef HOT_TUB_CONTROLLER_SECRETS_H
#define HOT_TUB_CONTROLLER_SECRETS_H

// Wifi configuration is now set interactively


// Soft AP Wifi - this is the Wifi network
// hosted by the controller itself for bootstrap configuration
// connect to this and pull up http://192.168.4.1 to
// use and configure the controller
#define SOFTAP_WIFI_NAME "hottubctl"
// set to NULL to make it open
#define SOFTAP_WIFI_PASS "secretpassword"

// HTTP Basic Auth credentials protecting firmware update (/update),
// filesystem editor (/edit, /list) and WiFi config (/configureWifi).
// Change these! (defaults to admin/admin if left undefined)
#define OTA_AUTH_USER "admin"
#define OTA_AUTH_PASS "admin"

// Send a POST request with hot tub status (JSON) to this URL
// this is useful to send data to a remote server for monitoring
// This is the same JSON as seen in http://hot.tub.ip/status
#define REPORT_SEND_URL "https://some.server/url"
// ms, comment out to disable this functionality
#define REPORT_SEND_FREQUENCY = 300000

#endif //HOT_TUB_CONTROLLER_SECRETS_H
